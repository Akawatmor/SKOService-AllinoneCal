export interface Element {
  number: number;
  symbol: string;
  name: string;
  nameTh: string;
  atomicMass: number;
  group?: number;
  period: number;
  category: string;
  electronConfig: string;
  electronegativity?: number;
  oxidationStates: string;
  meltingPoint?: number; // Kelvin
  boilingPoint?: number; // Kelvin
  density?: number; // g/cm³
  discoveryYear?: number;
}

